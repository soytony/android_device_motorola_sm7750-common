soong_namespace {
    imports: [
        "hardware/google/interfaces",
        "hardware/google/pixel",
        "hardware/lineage/interfaces/power-libperfmgr",
        "hardware/motorola",
        "hardware/qcom-caf/common/libqti-perfd-client",
        "vendor/motorola/sm7750-common",
    ],
}

// Motorola's system_ext performance JNI expects the newer system-client ABI,
// while the shipped vendor client lacks only this HAL-version entry point.
cc_library_shared {
    name: "libqti-perfd-client_system",
    srcs: ["shims/qti_perfd_client_system.cpp"],
    shared_libs: ["libqti-perfd-client-impl_system"],
    system_ext_specific: true,
}

install_symlink {
    name: "firmware_wlanmdsp.otaupdate_symlink",
    vendor: true,
    installed_location: "firmware/wlanmdsp.otaupdate",
    symlink_target: "/data/vendor/firmware/wlanmdsp.mbn",
}
install_symlink {
    name: "firmware_wlan_mac.bin_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/qca6750/wlan_mac.bin",
    symlink_target: "/mnt/vendor/persist/qca6750/wlan_mac.bin",
}
install_symlink {
    name: "firmware_WCNSS_qcom_cfg.ini_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/qca6750/WCNSS_qcom_cfg.ini",
    symlink_target: "/vendor/etc/wifi/qca6750/WCNSS_qcom_cfg.ini",
}

// The vendor QCA6750 module loads this regional supplement in addition to the
// base configuration when the device is using the PRC WLAN profile.
install_symlink {
    name: "firmware_WCNSS_prc_cfg.ini_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/qca6750/WCNSS_prc_cfg.ini",
    symlink_target: "/vendor/etc/wifi/qca6750/WCNSS_prc_cfg.ini",
}

install_symlink {
    name: "android.hardware.bluetooth@1.0-impl-qti_vendor_symlink",
    vendor: true,
    installed_location: "lib64/android.hardware.bluetooth@1.0-impl-qti.so",
    symlink_target: "/vendor/lib64/hw/android.hardware.bluetooth@1.0-impl-qti.so",
}

install_symlink {
    name: "mbedtls_qti_vendor_symlink",
    vendor: true,
    installed_location: "lib64/mbedtls_qti.so",
    symlink_target: "/vendor/lib64/hw/mbedtls_qti.so",
}

sh_binary {
    name: "recovery_touch_start",
    src: "recovery/recovery_touch_start.sh",
    recovery: true,
}
