<compatibility-matrix version="9.0" type="framework">
    <!-- Roadstr's vendor-side bridge for the SystemUI UDFPS HBM request. -->
    <hal format="aidl" optional="true">
        <name>vendor.lineage.biometrics.udfps</name>
        <version>1</version>
        <interface>
            <name>IUdfpsHbm</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl" optional="true">
        <name>vendor.qti.hardware.qccsyshal</name>
        <transport>hwbinder</transport>
        <version>1.2</version>
        <interface>
            <name>IQccsyshal</name>
            <instance>qccsyshal</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>com.motorola.hardware.display.panel</name>
        <version>2</version>
        <interface>
            <name>IDisplayPanel</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>com.motorola.hardware.display.touch</name>
        <version>3</version>
        <interface>
            <name>IMotTouch</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>com.motorola.hardware.ifaa</name>
        <version>1</version>
        <interface>
            <name>IIFAADevice</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>motorola.hardware.fdr</name>
        <version>1</version>
        <interface>
            <name>IFdrControl</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>motorola.hardware.haptic</name>
        <version>2</version>
        <interface>
            <name>IMotHaptic</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>motorola.hardware.health</name>
        <version>1</version>
        <interface>
            <name>IMotoHealth</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>motorola.hardware.health.storage</name>
        <version>1</version>
        <interface>
            <name>IMotStorage</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>motorola.hardware.lpsensing</name>
        <version>1</version>
        <interface>
            <name>ILpSensing</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>motorola.hardware.power</name>
        <version>1-2</version>
        <interface>
            <name>IMdpfExt</name>
            <instance>default</instance>
        </interface>
        <interface>
            <name>IPowerExt</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>motorola.hardware.rpmb</name>
        <version>1</version>
        <interface>
            <name>IMotoRpmbHardware</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>motorola.hardware.sxf</name>
        <version>2</version>
        <interface>
            <name>IMotoSxf</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>motorola.hardware.wireless.wlc</name>
        <version>1</version>
        <interface>
            <name>IMotWlc</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.arcsoft.hardware.camera.postproc</name>
        <version>2</version>
        <interface>
            <name>IPostProcService</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.dolby.dms</name>
        <version>1</version>
        <interface>
            <name>IDms</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.zuialarm.hardware.alarm</name>
        <version>1</version>
        <interface>
            <name>IAlarm</name>
            <instance>default</instance>
        </interface>
    </hal>
</compatibility-matrix>
